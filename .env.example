# ============================================================
# UNSORTED STUDIO OS — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to Git — it's in .gitignore already.
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Your project URL (looks like https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your anon/public key (safe to use in browser — RLS handles security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_KEY_HERE

# ── VERCEL DEPLOYMENT ────────────────────────────────────────
# Add these same two vars in Vercel:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#   Name: VITE_SUPABASE_URL        Value: (same as above)
#   Name: VITE_SUPABASE_ANON_KEY   Value: (same as above)
